diff --git a/packages/client/ui-model-selection/tests/directory.client.spec.ts b/packages/client/ui-model-selection/tests/directory.client.spec.ts
new file mode 100644
index 0000000..ca61450
--- /dev/null
+++ b/packages/client/ui-model-selection/tests/directory.client.spec.ts
@@ -0,0 +1,96 @@
+import { describe, expect, it, vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { ModelCatalogDirectory } from '../src/client/catalog.ts'
+import { ModelDirectory } from '../src/client/directory.ts'
+
+const selection = { provider: 'fixture', model: 'fast' }
+const catalog = {
+  default: selection,
+  routableProviders: ['fixture'],
+  groups: [{ id: 'fixture', name: 'Fixture', models: [{ id: 'fast', name: 'Fast' }] }],
+  failures: [],
+}
+
+async function subject(selectModel: ReturnType<typeof vi.fn>) {
+  return (await subjectWithCatalog(selectModel)).directory
+}
+
+async function subjectWithCatalog(selectModel: ReturnType<typeof vi.fn>) {
+  const remote = { session: { modelCatalog: vi.fn().mockResolvedValue({ ok: true, value: catalog }) } }
+  const catalogDirectory = new ModelCatalogDirectory({ remote } as never)
+  await catalogDirectory.load()
+  const projected = createSnapshotStore({ next: selection })
+  return {
+    directory: new ModelDirectory({ selectModel } as never, 'session-fixture' as never, () => true, catalogDirectory, projected),
+    catalogDirectory,
+  }
+}
+
+describe('ModelDirectory transport recovery', () => {
+  it('retries one thrown transport failure and unlocks after success', async () => {
+    const selectModel = vi.fn()
+      .mockRejectedValueOnce(new TypeError('Failed to fetch'))
+      .mockResolvedValueOnce({ ok: true, value: { selected: selection } })
+    const directory = await subject(selectModel)
+    await expect(directory.select(selection)).resolves.toBeUndefined()
+    expect(selectModel).toHaveBeenCalledTimes(2)
+    expect(directory.store.getSnapshot()).toMatchObject({ status: 'ready', error: null })
+  })
+
+  it('unlocks and exposes the transport error after the bounded retry fails', async () => {
+    const selectModel = vi.fn().mockRejectedValue(new TypeError('Failed to fetch'))
+    const directory = await subject(selectModel)
+    await expect(directory.select(selection)).rejects.toThrow('Failed to fetch')
+    expect(selectModel).toHaveBeenCalledTimes(2)
+    expect(directory.store.getSnapshot()).toMatchObject({ status: 'error', error: 'Failed to fetch' })
+  })
+
+  it('does not retry an explicit Remote failure', async () => {
+    const selectModel = vi.fn().mockResolvedValue({
+      ok: false, error: { code: 'session/model-unavailable', message: 'not served', details: {} },
+    })
+    const directory = await subject(selectModel)
+    await expect(directory.select(selection)).rejects.toThrow('session.selectModel failed')
+    expect(selectModel).toHaveBeenCalledTimes(1)
+    expect(directory.store.getSnapshot()).toMatchObject({ status: 'error' })
+  })
+
+  it('keeps a selection failure visible while the shared catalog refreshes', async () => {
+    const selectModel = vi.fn().mockResolvedValue({
+      ok: false, error: { code: 'session/model-unavailable', message: 'not served', details: {} },
+    })
+    const { directory, catalogDirectory } = await subjectWithCatalog(selectModel)
+    await expect(directory.select(selection)).rejects.toThrow('session.selectModel failed')
+    expect(directory.store.getSnapshot()).toMatchObject({
+      status: 'error', error: 'session/model-unavailable: not served',
+    })
+
+    catalogDirectory.refresh()
+    await catalogDirectory.load()
+    expect(directory.store.getSnapshot()).toMatchObject({
+      status: 'error', error: 'session/model-unavailable: not served',
+    })
+  })
+
+  it('does not retry a thrown selection after a Host reset invalidates its generation', async () => {
+    vi.useFakeTimers()
+    try {
+      const firstError = new TypeError('transport offline')
+      const selectModel = vi.fn().mockRejectedValueOnce(firstError)
+      const directory = await subject(selectModel)
+      const pending = directory.select(selection)
+      void pending.catch(() => undefined)
+      await Promise.resolve()
+      await Promise.resolve()
+      expect(selectModel).toHaveBeenCalledTimes(1)
+
+      directory.resetConnected()
+      await vi.advanceTimersByTimeAsync(150)
+      await expect(pending).rejects.toThrow('transport offline')
+      expect(selectModel).toHaveBeenCalledTimes(1)
+      expect(directory.store.getSnapshot()).toMatchObject({ status: 'ready', error: null })
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})
