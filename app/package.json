{
  "name": "deepseek-desktop",
  "productName": "DeepSeek",
  "version": "2.2.0",
  "description": "Community-maintained Windows desktop shell for DeepSeek Harness",
  "author": "DeepSeek Harness Desktop contributors",
  "license": "MIT",
  "homepage": "https://github.com/yijigao/deepseek-harness-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/yijigao/deepseek-harness-desktop.git"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "electron .",
    "start:harness-lab-demo": "electron . --demo-harness-lab",
    "start:model-settings-demo": "electron . --demo-model-settings",
    "test": "node --test ../tests/*.test.js",
    "secret-scan": "node ../scripts/secret-scan.mjs",
    "fixtures:harness-lab": "node ../scripts/generate-harness-lab-fixtures.mjs",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": ["demo/**/*"],
    "npmRebuild": false,
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "titlebar.js",
      "claude-theme.css",
      "harness-lab-button.css",
      "harness-lab/**/*",
      "model-settings/**/*",
      "lib/**/*",
      "demo/**/*",
      "fix-junctions.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../staging/payload", "to": "." },
      { "from": "../config-example/oauth-login-openai-codex.mjs", "to": "tools/oauth-login-openai-codex.mjs" },
      { "from": "../config-example/test-openai-codex.mjs", "to": "tools/test-openai-codex.mjs" },
      { "from": "../scripts/patch-pi-ai-oauth.mjs", "to": "tools/patch-pi-ai-oauth.mjs" },
      { "from": "../scripts/model-resource-probe.mjs", "to": "tools/model-resource-probe.mjs" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek",
      "artifactName": "DeepSeek-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DeepSeek-Desktop-${version}-portable.${ext}"
    }
  }
}
